{
  "name": "waveamp",
  "version": "1.13.3",
  "private": true,
  "description": "Retro-style desktop audio player with internet radio, built on Electron",
  "author": "Dark.Dmake",
  "homepage": "https://github.com/darkdkl/waveamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkdkl/waveamp.git"
  },
  "bugs": {
    "url": "https://github.com/darkdkl/waveamp/issues"
  },
  "keywords": [
    "audio-player",
    "internet-radio",
    "equalizer",
    "electron",
    "music"
  ],
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "licenses": "node scripts/generateThirdPartyLicenses.js",
    "prestart": "npm run licenses",
    "start": "electron-vite preview",
    "predev": "npm run licenses",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "build:mac": "npm run licenses && electron-vite build && electron-builder --mac --publish=never",
    "build:linux": "npm run licenses && electron-vite build && electron-builder --linux --publish=never",
    "build:win": "npm run licenses && electron-vite build && electron-builder --win --publish=never",
    "release:mac": "npm run licenses && electron-vite build && electron-builder --mac --publish always",
    "release:linux": "npm run licenses && electron-vite build && electron-builder --linux --publish always",
    "release:win": "npm run licenses && electron-vite build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.darkdkl.waveamp",
    "productName": "WaveAMP",
    "copyright": "Copyright © 2026 Dark.Dmake",
    "publish": {
      "provider": "github",
      "owner": "darkdkl",
      "repo": "waveamp",
      "releaseType": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "afterSign": "scripts/afterSignAdHoc.js",
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "music-metadata": "^11.16.1"
  }
}
