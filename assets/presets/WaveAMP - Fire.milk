comp_1=`float fr(float x) { return x - floor(x); }
comp_2=`float nz(float2 x) { return tex2D(sampler_noise_hq, x * 0.03125).x; }
comp_3=`float fbm(float2 x) { return 0.5 * nz(x) + 0.25 * nz(x * 2.03 + 7.1) + 0.15 * nz(x * 4.07 + 3.3) + 0.1 * nz(x * 8.11 + 1.9); }
comp_4=`shader_body
comp_5=`{
comp_6=`  float2 p = (uv - 0.5) * aspect.xy / min(aspect.x, aspect.y);
comp_7=`  float2 q = float2(p.x, 0.5 - p.y);
comp_8=`  float t = q1;
comp_9=`  float warp = fbm(float2(q.x * 3.0, q.y * 2.4 - t * 1.3));
comp_10=`  float f = fbm(float2(q.x * 4.2 + warp * 1.4, q.y * 3.0 - t * 2.1 + warp * 0.6));
comp_11=`  float halfW = aspect.x / min(aspect.x, aspect.y) * 0.5;
comp_12=`  float bx = saturate((p.x + halfW) / (2 * halfW)) * 15.0;
comp_13=`  float b0 = floor(bx);
comp_14=`  float b1 = min(b0 + 1, 15.0);
comp_15=`  float s0 = 0;
comp_16=`  float s1 = 0;
comp_17=`  s0 += (b0 == 0) * q5;
comp_18=`  s1 += (b1 == 0) * q5;
comp_19=`  s0 += (b0 == 1) * q6;
comp_20=`  s1 += (b1 == 1) * q6;
comp_21=`  s0 += (b0 == 2) * q7;
comp_22=`  s1 += (b1 == 2) * q7;
comp_23=`  s0 += (b0 == 3) * q8;
comp_24=`  s1 += (b1 == 3) * q8;
comp_25=`  s0 += (b0 == 4) * q9;
comp_26=`  s1 += (b1 == 4) * q9;
comp_27=`  s0 += (b0 == 5) * q10;
comp_28=`  s1 += (b1 == 5) * q10;
comp_29=`  s0 += (b0 == 6) * q11;
comp_30=`  s1 += (b1 == 6) * q11;
comp_31=`  s0 += (b0 == 7) * q12;
comp_32=`  s1 += (b1 == 7) * q12;
comp_33=`  s0 += (b0 == 8) * q13;
comp_34=`  s1 += (b1 == 8) * q13;
comp_35=`  s0 += (b0 == 9) * q14;
comp_36=`  s1 += (b1 == 9) * q14;
comp_37=`  s0 += (b0 == 10) * q15;
comp_38=`  s1 += (b1 == 10) * q15;
comp_39=`  s0 += (b0 == 11) * q16;
comp_40=`  s1 += (b1 == 11) * q16;
comp_41=`  s0 += (b0 == 12) * q17;
comp_42=`  s1 += (b1 == 12) * q17;
comp_43=`  s0 += (b0 == 13) * q18;
comp_44=`  s1 += (b1 == 13) * q18;
comp_45=`  s0 += (b0 == 14) * q19;
comp_46=`  s1 += (b1 == 14) * q19;
comp_47=`  s0 += (b0 == 15) * q20;
comp_48=`  s1 += (b1 == 15) * q20;
comp_49=`  float spec = lerp(s0, s1, smoothstep(0.0, 1.0, bx - b0));
comp_50=`  float h = 0.28 + 0.58 * spec + 0.10 * q2 + 0.08 * q3;
comp_51=`  float edge = 1.0 - 0.18 * pow(abs(p.x) / halfW, 3.0);
comp_52=`  float heat = saturate((f * 1.35 - 0.12 - q.y / (h * edge)) * 1.3);
comp_53=`  float3 col = float3(0.012, 0.004, 0.002);
comp_54=`  col += float3(saturate(heat * 1.6), saturate(pow(heat, 1.8) * 0.9), saturate(pow(heat, 6.0) * 0.35));
comp_55=`  col += float3(0.30, 0.07, 0.01) * saturate(1.0 - q.y * 1.4) * 0.35;
comp_56=`  float sparks = 0;
comp_57=`  for (int k = 0; k < 2; k++) {
comp_58=`    float d = 22.0 + k * 14.0;
comp_59=`    float2 g = float2(q.x * d, (q.y - t * (0.32 + k * 0.14)) * d);
comp_60=`    float2 c = floor(g);
comp_61=`    float hs = fr(sin(dot(c, float2(12.9898, 78.233)) + k * 4.1) * 43758.5453);
comp_62=`    float2 o = float2(fr(hs * 17.3) - 0.5, fr(hs * 41.7) - 0.5) * 0.6;
comp_63=`    float sway = sin(t * 2.0 + hs * 30.0) * 0.18;
comp_64=`    float s = smoothstep(0.09, 0.0, length(g - c - 0.5 - o - float2(sway, 0)));
comp_65=`    sparks += s * step(0.93 - 0.05 * q4, hs) * saturate(1.0 - q.y * 1.15) * (0.6 + 0.4 * fr(hs * 91.1));
comp_66=`  }
comp_67=`  col += float3(1.0, 0.62, 0.25) * sparks * 1.6;
comp_68=`  ret = col;
comp_69=`}
