per_frame_1=dt = min(max(time - gmegabuf(0), 0), 0.1);
per_frame_2=gmegabuf(0) = time;
per_frame_3=lvl = min(1, max(0, (bass_att - 0.4) / 1.4));
per_frame_4=gmegabuf(1) = gmegabuf(1) + (lvl - gmegabuf(1)) * (1 - exp(-dt * if(above(lvl, gmegabuf(1)), 6, 1.5)));
per_frame_5=gmegabuf(20) = gmegabuf(20) * 0.97 + 0.03 * bass;
per_frame_6=kick = above(bass, gmegabuf(20) * 1.2 + 0.05) * above(time - gmegabuf(21), 0.25);
per_frame_7=gmegabuf(21) = if(kick, time, gmegabuf(21));
per_frame_8=gmegabuf(2) = max(gmegabuf(2) * exp(-dt * 4), kick);
per_frame_9=gmegabuf(3) = gmegabuf(3) + (min(1, treb_att / 2) - gmegabuf(3)) * (1 - exp(-dt * 4));
per_frame_10=gmegabuf(4) = gmegabuf(4) + dt * (0.55 + 0.35 * gmegabuf(1));
per_frame_11=q1 = gmegabuf(4);
per_frame_12=q2 = gmegabuf(1);
per_frame_13=q3 = gmegabuf(2);
per_frame_14=q4 = gmegabuf(3);
per_frame_15=v = min(1, pow(gmegabuf(30) * 3.6, 0.8));
per_frame_16=g = gmegabuf(100);
per_frame_17=gmegabuf(100) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_18=q5 = gmegabuf(100);
per_frame_19=gmegabuf(30) = 0;
per_frame_20=v = min(1, pow(gmegabuf(31) * 3.6, 0.8));
