per_frame_75=g = gmegabuf(111);
per_frame_76=gmegabuf(111) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_77=q16 = gmegabuf(111);
per_frame_78=gmegabuf(41) = 0;
per_frame_79=v = min(1, pow(gmegabuf(42) * 3.6, 0.8));
per_frame_80=g = gmegabuf(112);
per_frame_81=gmegabuf(112) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_82=q17 = gmegabuf(112);
per_frame_83=gmegabuf(42) = 0;
per_frame_84=v = min(1, pow(gmegabuf(43) * 3.6, 0.8));
per_frame_85=g = gmegabuf(113);
per_frame_86=gmegabuf(113) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_87=q18 = gmegabuf(113);
