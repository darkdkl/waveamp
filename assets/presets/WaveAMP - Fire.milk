per_frame_89=v = min(1, pow(gmegabuf(44) * 3.6, 0.8));
per_frame_90=g = gmegabuf(114);
per_frame_91=gmegabuf(114) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_92=q19 = gmegabuf(114);
per_frame_93=gmegabuf(44) = 0;
per_frame_94=v = min(1, pow(gmegabuf(45) * 3.6, 0.8));
per_frame_95=g = gmegabuf(115);
per_frame_96=gmegabuf(115) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_97=q20 = gmegabuf(115);
per_frame_98=gmegabuf(45) = 0;
comp_1=`float fr(float x) { return x - floor(x); }
comp_2=`float nz(float2 x) { return tex2D(sampler_noise_hq, x * 0.03125).x; }
comp_3=`float fbm(float2 x) { return 0.5 * nz(x) + 0.25 * nz(x * 2.03 + 7.1) + 0.15 * nz(x * 4.07 + 3.3) + 0.1 * nz(x * 8.11 + 1.9); }
comp_4=`shader_body
comp_5=`{
comp_6=`  float2 p = (uv - 0.5) * aspect.xy / min(aspect.x, aspect.y);
comp_7=`  float2 q = float2(p.x, 0.5 - p.y);
comp_8=`  float t = q1;
comp_9=`  float src = smoothstep(0.3, 0.72, nz(float2(q.x * 1.7 + 11.0, t * 0.10)) * 0.65 + nz(float2(q.x * 3.9 + 5.0, t * 0.17 + 3.0)) * 0.35);
comp_10=`  float tongue = nz(float2(q.x * 8.0 + 2.0, t * 0.5));
comp_11=`  float warp = fbm(float2(q.x * 4.0, q.y * 1.6 - t * 1.3));
comp_12=`  float f = fbm(float2(q.x * 6.5 + warp * 1.6, q.y * 2.2 - t * 2.3 + warp * 0.5));
comp_13=`  float halfW = aspect.x / min(aspect.x, aspect.y) * 0.5;
comp_14=`  float bx = saturate((p.x + halfW) / (2 * halfW)) * 15.0;
comp_15=`  float b0 = floor(bx);
comp_16=`  float b1 = min(b0 + 1, 15.0);
comp_17=`  float s0 = 0;
comp_18=`  float s1 = 0;
comp_19=`  s0 += (b0 == 0) * q5;
comp_20=`  s1 += (b1 == 0) * q5;
comp_21=`  s0 += (b0 == 1) * q6;
comp_22=`  s1 += (b1 == 1) * q6;
comp_23=`  s0 += (b0 == 2) * q7;
comp_24=`  s1 += (b1 == 2) * q7;
comp_25=`  s0 += (b0 == 3) * q8;
comp_26=`  s1 += (b1 == 3) * q8;
comp_27=`  s0 += (b0 == 4) * q9;
comp_28=`  s1 += (b1 == 4) * q9;
comp_29=`  s0 += (b0 == 5) * q10;
comp_30=`  s1 += (b1 == 5) * q10;
comp_31=`  s0 += (b0 == 6) * q11;
comp_32=`  s1 += (b1 == 6) * q11;
comp_33=`  s0 += (b0 == 7) * q12;
comp_34=`  s1 += (b1 == 7) * q12;
comp_35=`  s0 += (b0 == 8) * q13;
comp_36=`  s1 += (b1 == 8) * q13;
comp_37=`  s0 += (b0 == 9) * q14;
comp_38=`  s1 += (b1 == 9) * q14;
comp_39=`  s0 += (b0 == 10) * q15;
comp_40=`  s1 += (b1 == 10) * q15;
comp_41=`  s0 += (b0 == 11) * q16;
comp_42=`  s1 += (b1 == 11) * q16;
comp_43=`  s0 += (b0 == 12) * q17;
comp_44=`  s1 += (b1 == 12) * q17;
comp_45=`  s0 += (b0 == 13) * q18;
comp_46=`  s1 += (b1 == 13) * q18;
comp_47=`  s0 += (b0 == 14) * q19;
comp_48=`  s1 += (b1 == 14) * q19;
comp_49=`  s0 += (b0 == 15) * q20;
comp_50=`  s1 += (b1 == 15) * q20;
comp_51=`  float spec = lerp(s0, s1, smoothstep(0.0, 1.0, bx - b0));
comp_52=`  float h = (0.30 + 0.62 * spec + 0.10 * q2 + 0.06 * q3) * (0.55 + 0.75 * src) * (0.72 + 0.56 * tongue);
comp_53=`  float edge = 1.0 - 0.18 * pow(abs(p.x) / halfW, 3.0);
comp_54=`  float base = f * 1.35 - 0.10 - 0.24 * (1.0 - src);
comp_55=`  float top = base * h * edge;
comp_56=`  float heat = saturate((base - q.y / (h * edge)) * 1.3);
comp_57=`  float above = q.y - top;
comp_58=`  float tipLine = 0.62 * h * edge;
comp_59=`  float3 bg = lerp(float3(0.20, 0.07, 0.022), float3(0.008, 0.012, 0.035), smoothstep(0.05, 0.75, q.y));
comp_60=`  float2 sg = p * 46.0;
comp_61=`  float2 sc = floor(sg);
comp_62=`  float sh = fr(sin(dot(sc, float2(12.9898, 78.233))) * 43758.5453);
comp_63=`  float2 so = (float2(fr(sh * 17.3), fr(sh * 41.7)) - 0.5) * 0.7;
comp_64=`  float flare = q21 * step(0.95, fr(sin(sh * 311.7 + q22 * 7.13) * 43758.5453));
comp_65=`  bg += float3(0.75, 0.8, 1.0) * smoothstep(0.0022 + 0.0016 * flare, 0.0, length(sg - sc - 0.5 - so) / 46.0) * step(0.86, sh) * (0.25 + 0.75 * fr(sh * 91.1) + 1.6 * flare) * smoothstep(0.2, 0.5, q.y);
comp_66=`  float sm1 = fbm(float2(q.x * 2.0 + 4.0, q.y * 1.3 - t * 0.28));
comp_67=`  float sm = fbm(float2(q.x * 2.6 + sm1 * 1.2, q.y * 1.8 - t * 0.4));
comp_68=`  float dens = smoothstep(0.52, 0.82, sm) * smoothstep(0.12, 0.45, q.y) * (1.0 - smoothstep(0.65, 1.0, q.y));
comp_69=`  float3 smokeC = lerp(float3(0.22, 0.10, 0.05), float3(0.13, 0.125, 0.13), smoothstep(0.15, 0.6, q.y)) * 1.6;
comp_70=`  bg = lerp(bg, smokeC, dens * 0.45);
comp_71=`  float3 fc = float3(saturate(heat * 1.6), saturate(pow(heat, 1.8) * 0.9), saturate(pow(heat, 6.0) * 0.35));
comp_72=`  float3 col = bg * (1.0 - saturate(heat * 2.5)) + fc;
comp_73=`  float coal = (1.0 - src) * smoothstep(0.07, 0.0, q.y) * smoothstep(0.35, 0.8, nz(q * 38.0 + float2(0, t * 0.3)));
comp_74=`  col += float3(0.55, 0.10, 0.02) * coal;
comp_75=`  float sparks = 0;
comp_76=`  float tall = smoothstep(0.56, 0.74, tongue) * smoothstep(0.4, 0.7, src);
comp_77=`  float rise = q.y - 0.06;
comp_78=`  float u = sqrt(max(rise, 0.0) + 0.0004);
comp_79=`  for (int k = 0; k < 2; k++) {
comp_80=`    float d = 20.0 + k * 13.0;
comp_81=`    float du = 26.0 + k * 10.0;
comp_82=`    float2 g = float2(q.x * d, (u - t * (0.10 + k * 0.035)) * du);
comp_83=`    float2 c = floor(g);
comp_84=`    float hs = fr(sin(dot(c, float2(12.9898, 78.233)) + k * 4.1) * 43758.5453);
comp_85=`    float2 o = float2(fr(hs * 17.3) - 0.5, fr(hs * 41.7) - 0.5) * 0.6;
comp_86=`    float sway = sin(t * 2.0 + hs * 30.0) * 0.15;
comp_87=`    float sp = smoothstep(0.11, 0.0, length(g - c - 0.5 - o - float2(sway, 0)));
comp_88=`    sparks += sp * step(0.82 - 0.05 * q4, hs) * smoothstep(0.0, 0.04, above) * smoothstep(0.0, 0.03, q.y - tipLine) * (1.0 - smoothstep(0.08, 0.4, q.y - tipLine)) * tall * (0.6 + 0.4 * fr(hs * 91.1));
comp_89=`  }
comp_90=`  col += float3(1.0, 0.55, 0.18) * sparks * 1.15;
comp_91=`  ret = col;
comp_92=`}
