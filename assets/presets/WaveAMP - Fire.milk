per_frame_1=dt = min(max(time - gmegabuf(0), 0), 0.1);
per_frame_2=gmegabuf(0) = time;
per_frame_3=lvl = min(1, max(0, (bass_att - 0.4) / 1.4));
per_frame_4=gmegabuf(1) = gmegabuf(1) + (lvl - gmegabuf(1)) * (1 - exp(-dt * if(above(lvl, gmegabuf(1)), 6, 1.5)));
per_frame_5=gmegabuf(20) = gmegabuf(20) * 0.97 + 0.03 * bass;
per_frame_6=kick = above(bass, gmegabuf(20) * 1.2 + 0.05) * above(time - gmegabuf(21), 0.25);
per_frame_7=gmegabuf(21) = if(kick, time, gmegabuf(21));
per_frame_8=gmegabuf(2) = max(gmegabuf(2) * exp(-dt * 4), kick);
per_frame_9=gmegabuf(5) = gmegabuf(5) + kick;
per_frame_10=gmegabuf(6) = max(gmegabuf(6) * exp(-dt * 7), kick);
per_frame_11=gmegabuf(3) = gmegabuf(3) + (min(1, treb_att / 2) - gmegabuf(3)) * (1 - exp(-dt * 4));
per_frame_12=gmegabuf(4) = gmegabuf(4) + dt * (0.55 + 0.35 * gmegabuf(1));
per_frame_13=q1 = gmegabuf(4);
per_frame_14=q2 = gmegabuf(1);
per_frame_15=q3 = gmegabuf(2);
per_frame_16=q4 = gmegabuf(3);
per_frame_17=q21 = gmegabuf(6);
per_frame_18=q22 = gmegabuf(5);
per_frame_19=v = min(1, pow(gmegabuf(30) * 3.6, 0.8));
per_frame_20=g = gmegabuf(100);
per_frame_21=gmegabuf(100) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_22=q5 = gmegabuf(100);
per_frame_23=gmegabuf(30) = 0;
per_frame_24=v = min(1, pow(gmegabuf(31) * 3.6, 0.8));
per_frame_25=g = gmegabuf(101);
per_frame_26=gmegabuf(101) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_27=q6 = gmegabuf(101);
per_frame_28=gmegabuf(31) = 0;
per_frame_29=v = min(1, pow(gmegabuf(32) * 3.6, 0.8));
per_frame_30=g = gmegabuf(102);
per_frame_31=gmegabuf(102) = g + (v - g) * (1 - exp(-dt * if(above(v, g), 9, 2.2)));
per_frame_32=q7 = gmegabuf(102);
