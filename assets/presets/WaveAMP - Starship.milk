comp_160=`  d = min(d, seg(l, float2(-1.0000, -0.1000), float2(-0.9600, -0.1900)));
comp_161=`  d = min(d, seg(l, float2(-0.9600, -0.1900), float2(-0.3100, -0.1500)));
