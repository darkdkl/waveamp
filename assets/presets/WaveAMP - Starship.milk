comp_168=`  d = min(d, seg(l, float2(0.0000, 0.5200), float2(0.0700, 0.2200)));
comp_169=`  d = min(d, seg(l, float2(0.0700, 0.2200), float2(-0.0700, 0.2200)));
comp_170=`
comp_171=`  float3 shipC = float3(0.85, 0.90, 0.96);
comp_172=`  col += shipC * (smoothstep(0.03, 0.0, d) * (0.45 + 0.7 * q3) + exp(-d * 12) * (0.04 + 0.3 * q3));
comp_173=`  float pulse = q3;
comp_174=`  float er = 0.07 + 0.05 * pulse;
comp_175=`  float e1 = length(l - float2(-0.15, -0.05));
comp_176=`  float e2 = length(l - float2(0.15, -0.05));
comp_177=`  float e = min(e1, e2);
comp_178=`  col += float3(1.0, 0.55, 0.15) * (smoothstep(er, 0.0, e) * (0.8 + 0.6 * pulse) + exp(-e * (14 - 8 * pulse)) * (0.2 + 0.9 * pulse));
comp_179=`  col += shipC * smoothstep(0.035, 0.0, abs(e - er - 0.02)) * 0.45;
comp_180=`  }
comp_181=`  ret = 1 - exp(-col * 1.4);
comp_182=`}
