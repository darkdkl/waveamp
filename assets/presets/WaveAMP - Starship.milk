comp_1=`float fr(float x) { return x - floor(x); }
comp_2=`float hs(float2 c) { return fr(sin(dot(c, float2(127.1, 311.7))) * 43758.5453); }
comp_3=`float vn(float2 x) { float2 i = floor(x); float2 u = x - i; u = u * u * (3 - 2 * u); return lerp(lerp(hs(i), hs(i + float2(1, 0)), u.x), lerp(hs(i + float2(0, 1)), hs(i + float2(1, 1)), u.x), u.y); }
comp_4=`float fbm(float2 x) { return 0.5 * vn(x) + 0.25 * vn(x * 2.03 + 1.7) + 0.125 * vn(x * 4.01 + 3.1) + 0.0625 * vn(x * 8.05 + 5.3); }
comp_5=`float seg(float2 p, float2 a, float2 b) { float2 pa = p - a; float2 ba = b - a; float h = saturate(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }
comp_6=`shader_body
comp_7=`{
comp_8=`  float2 p = (uv - 0.5) * aspect.xy / min(aspect.x, aspect.y);
comp_9=`  p.y = -p.y;
comp_10=`  float3 starC = float3(0.75, 0.85, 1.0) * (0.7 + 0.45 * min(q4, 1.6));
comp_11=`  float3 rockC = float3(0.75, 0.35, 1.0) * (0.8 + 0.3 * min(q4, 1.6));
comp_12=`  float3 col = float3(0.0, 0.006, 0.02) * (1.4 - length(p));
comp_13=`  float2 nq = p * 1.8 + float2(time * 0.012, time * 0.004);
comp_14=`  float n1 = fbm(nq);
comp_15=`  float n2 = fbm(nq * 1.6 + float2(5.2, 1.3) + n1 * 1.5);
comp_16=`  float cloud = smoothstep(0.32, 0.78, n1 * 0.6 + n2 * 0.6) * (0.55 + 0.45 * exp(-length(p) * 1.4));
comp_17=`  float3 neb = lerp(float3(0.42, 0.10, 0.62), float3(0.05, 0.40, 0.55), smoothstep(0.35, 0.7, n2));
comp_18=`  neb += float3(0.55, 0.25, 0.65) * pow(saturate(n2 * 1.5 - 0.45), 3) * 1.6;
comp_19=`  col += neb * cloud * 0.8;
comp_20=`  float z;
comp_21=`  float2 sp;
comp_22=`  float2 rc;
comp_23=`  float rs;
comp_24=`  float2 rq;
comp_25=`  float ra;
comp_26=`  float rd;
comp_27=`  z = max(fr(0.6509 - q1), 0.01);
