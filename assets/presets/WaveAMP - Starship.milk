comp_122=`  float sc = 0.12 * (1 - 0.34 * q18);
comp_123=`  if (length(p - pos) < sc * 1.5) {
comp_124=`  float2 l = (p - pos) / sc;
comp_125=`  float cb = cos(-bank);
comp_126=`  float sb = sin(-bank);
comp_127=`  l = float2(l.x * cb - l.y * sb, l.x * sb + l.y * cb);
comp_128=`  float d = 10;
comp_129=`  float inside;
comp_130=`  float shade = 0.55 + 0.45 * saturate(l.y * 2 + 0.5) + 0.35 * exp(-pow((l.y - 0.06) * 7, 2));
comp_131=`  inside = 0;
comp_132=`  inside += abs(step(l.y, -0.2000) - step(l.y, 0.0400)) * step(l.x, -0.0600 * (l.y - -0.2000) / 0.2400 + -0.3000);
comp_133=`  inside += abs(step(l.y, 0.0400) - step(l.y, 0.2200)) * step(l.x, 0.1600 * (l.y - 0.0400) / 0.1800 + -0.3600);
comp_134=`  inside += abs(step(l.y, 0.2200) - step(l.y, 0.0400)) * step(l.x, 0.1600 * (l.y - 0.2200) / -0.1800 + 0.2000);
comp_135=`  inside += abs(step(l.y, 0.0400) - step(l.y, -0.2000)) * step(l.x, -0.0600 * (l.y - 0.0400) / -0.2400 + 0.3600);
comp_136=`  col = lerp(col, float3(0.36, 0.40, 0.45) * shade, fr(inside * 0.5) * 2);
comp_137=`  inside = 0;
comp_138=`  inside += abs(step(l.y, 0.0200) - step(l.y, -0.1000)) * step(l.x, -0.6600 * (l.y - 0.0200) / -0.1200 + -0.3400);
comp_139=`  inside += abs(step(l.y, -0.1000) - step(l.y, -0.1900)) * step(l.x, 0.0400 * (l.y - -0.1000) / -0.0900 + -1.0000);
comp_140=`  inside += abs(step(l.y, -0.1900) - step(l.y, -0.1500)) * step(l.x, 0.6500 * (l.y - -0.1900) / 0.0400 + -0.9600);
comp_141=`  inside += abs(step(l.y, -0.1500) - step(l.y, 0.0200)) * step(l.x, -0.0300 * (l.y - -0.1500) / 0.1700 + -0.3100);
comp_142=`  col = lerp(col, float3(0.27, 0.31, 0.36) * shade, fr(inside * 0.5) * 2);
comp_143=`  inside = 0;
comp_144=`  inside += abs(step(l.y, 0.0200) - step(l.y, -0.1000)) * step(l.x, 0.6600 * (l.y - 0.0200) / -0.1200 + 0.3400);
comp_145=`  inside += abs(step(l.y, -0.1000) - step(l.y, -0.1900)) * step(l.x, -0.0400 * (l.y - -0.1000) / -0.0900 + 1.0000);
comp_146=`  inside += abs(step(l.y, -0.1900) - step(l.y, -0.1500)) * step(l.x, -0.6500 * (l.y - -0.1900) / 0.0400 + 0.9600);
comp_147=`  inside += abs(step(l.y, -0.1500) - step(l.y, 0.0200)) * step(l.x, 0.0300 * (l.y - -0.1500) / 0.1700 + 0.3100);
comp_148=`  col = lerp(col, float3(0.27, 0.31, 0.36) * shade, fr(inside * 0.5) * 2);
comp_149=`  inside = 0;
comp_150=`  inside += abs(step(l.y, 0.2200) - step(l.y, 0.5200)) * step(l.x, 0.0700 * (l.y - 0.2200) / 0.3000 + -0.0700);
comp_151=`  inside += abs(step(l.y, 0.5200) - step(l.y, 0.2200)) * step(l.x, 0.0700 * (l.y - 0.5200) / -0.3000 + 0.0000);
comp_152=`  col = lerp(col, float3(0.32, 0.36, 0.41) * shade, fr(inside * 0.5) * 2);
comp_153=`  d = min(d, seg(l, float2(-0.3000, -0.2000), float2(-0.3600, 0.0400)));
comp_154=`  d = min(d, seg(l, float2(-0.3600, 0.0400), float2(-0.2000, 0.2200)));
comp_155=`  d = min(d, seg(l, float2(-0.2000, 0.2200), float2(0.2000, 0.2200)));
comp_156=`  d = min(d, seg(l, float2(0.2000, 0.2200), float2(0.3600, 0.0400)));
comp_157=`  d = min(d, seg(l, float2(0.3600, 0.0400), float2(0.3000, -0.2000)));
comp_158=`  d = min(d, seg(l, float2(0.3000, -0.2000), float2(-0.3000, -0.2000)));
