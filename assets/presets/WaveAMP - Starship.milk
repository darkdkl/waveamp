comp_1=`#define SECTORS 24
comp_2=`float fr(float x) { return x - floor(x); }
comp_3=`float hs(float2 c) { return fr(sin(dot(c, float2(127.1, 311.7))) * 43758.5453); }
comp_4=`float vn(float2 x) { float2 i = floor(x); float2 u = x - i; u = u * u * (3 - 2 * u); return lerp(lerp(hs(i), hs(i + float2(1, 0)), u.x), lerp(hs(i + float2(0, 1)), hs(i + float2(1, 1)), u.x), u.y); }
comp_5=`float fbm(float2 x) { return 0.5 * vn(x) + 0.25 * vn(x * 2.03 + 1.7) + 0.125 * vn(x * 4.01 + 3.1) + 0.0625 * vn(x * 8.05 + 5.3); }
comp_6=`float star(float2 p, float s, float k, float t) {
comp_7=`  s = s - SECTORS * floor(s / SECTORS);
comp_8=`  float h = fr(sin(s * 12.9898 + k * 78.233) * 43758.5453);
comp_9=`  float a = (s + 0.15 + 0.7 * h) * 6.28318 / SECTORS;
comp_10=`  float r0 = 0.03 + 0.07 * fr(h * 13.7);
comp_11=`  float z = max(fr(fr(h * 71.3) - t), 0.01);
comp_12=`  float2 sp = float2(cos(a), sin(a)) * r0 / z;
comp_13=`  return smoothstep(0.0025 + 0.006 * (1 - z), 0.0, length(p - sp)) * smoothstep(0.95, 0.6, z);
comp_14=`}
comp_15=`float seg(float2 p, float2 a, float2 b) { float2 pa = p - a; float2 ba = b - a; float h = saturate(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }
comp_16=`shader_body
comp_17=`{
comp_18=`  float2 p = (uv - 0.5) * aspect.xy / min(aspect.x, aspect.y);
comp_19=`  p.y = -p.y;
comp_20=`  float3 starC = float3(0.75, 0.85, 1.0) * (0.7 + 0.45 * min(q4, 1.6));
comp_21=`  float3 col = float3(0.0, 0.006, 0.02) * (1.4 - length(p));
comp_22=`  float2 nq = p * 1.8 + float2(time * 0.012, time * 0.004);
comp_23=`  float n1 = fbm(nq);
comp_24=`  float n2 = fbm(nq * 1.6 + float2(5.2, 1.3) + n1 * 1.5);
comp_25=`  float cloud = smoothstep(0.32, 0.78, n1 * 0.6 + n2 * 0.6) * (0.55 + 0.45 * exp(-length(p) * 1.4));
comp_26=`  float3 neb = lerp(float3(0.42, 0.10, 0.62), float3(0.05, 0.40, 0.55), smoothstep(0.35, 0.7, n2));
comp_27=`  neb += float3(0.55, 0.25, 0.65) * pow(saturate(n2 * 1.5 - 0.45), 3) * 1.6;
comp_28=`  float far = 0;
comp_29=`  float2 fg0 = p * 38.0;
comp_30=`  float2 fc0 = floor(fg0);
comp_31=`  float fh0 = fr(sin(dot(fc0, float2(12.9898, 78.233)) + 0.0) * 43758.5453);
comp_32=`  float2 fo0 = (float2(fr(fh0 * 17.3), fr(fh0 * 41.7)) - 0.5) * 0.7;
comp_33=`  far += smoothstep(0.0020, 0.0, length(fg0 - fc0 - 0.5 - fo0) / 38.0) * step(0.9, fh0) * (0.3 + 0.7 * fr(fh0 * 91.1));
comp_34=`  float2 fg1 = p * 70.0;
comp_35=`  float2 fc1 = floor(fg1);
comp_36=`  float fh1 = fr(sin(dot(fc1, float2(12.9898, 78.233)) + 3.1) * 43758.5453);
comp_37=`  float2 fo1 = (float2(fr(fh1 * 17.3), fr(fh1 * 41.7)) - 0.5) * 0.7;
comp_38=`  far += smoothstep(0.0020, 0.0, length(fg1 - fc1 - 0.5 - fo1) / 70.0) * step(0.88, fh1) * (0.3 + 0.7 * fr(fh1 * 91.1));
comp_39=`  col += float3(0.80, 0.85, 1.0) * far * 0.75 * (1 - cloud * 0.75);
comp_40=`  col += neb * cloud * 0.8;
comp_41=`  float z;
comp_42=`  float sa = atan2(p.y, p.x) / 6.28318 * SECTORS;
comp_43=`  float s0 = floor(sa);
comp_44=`  float s1 = s0 + 2 * step(0.5, sa - s0) - 1;
comp_45=`  float2 rc;
comp_46=`  float rs;
comp_47=`  float2 rq;
comp_48=`  float ra;
comp_49=`  float rd;
comp_50=`  float2 rn;
comp_51=`  float rl;
comp_52=`  float2 rk;
comp_53=`  float rcr;
comp_54=`  float3 rockCol;
comp_55=`  col += starC * (star(p, s0, 0, q1) + star(p, s1, 0, q1));
comp_56=`  col += starC * (star(p, s0, 1, q1) + star(p, s1, 1, q1));
comp_57=`  col += starC * (star(p, s0, 2, q1) + star(p, s1, 2, q1));
comp_58=`  z = max(q5, 0.01);
comp_59=`  rc = float2(cos(q9), sin(q9)) * q13 / z;
comp_60=`  rs = 0.0055 / z;
comp_61=`  if (length(p - rc) < rs * 1.3 + 0.004) {
comp_62=`  rq = (p - rc) / rs;
comp_63=`  ra = atan2(rq.y, rq.x) + time * 0.2500 + 1.3000;
comp_64=`  rd = (length(rq) - (1 + 0.16 * sin(5 * ra + 1.3000) + 0.08 * sin(9 * ra + 2.6000))) * rs;
comp_65=`  rn = rq / 1.15;
comp_66=`  rl = saturate(dot(float3(rn, sqrt(saturate(1 - dot(rn, rn)))), float3(-0.45, 0.5, 0.74)));
comp_67=`  rk = float2(rq.x * cos(time * 0.2500 + 1.3000) + rq.y * sin(time * 0.2500 + 1.3000), rq.y * cos(time * 0.2500 + 1.3000) - rq.x * sin(time * 0.2500 + 1.3000));
comp_68=`  rcr = smoothstep(0.24, 0.17, length(rk - float2(0.32, 0.22))) + smoothstep(0.17, 0.11, length(rk - float2(-0.30, -0.33))) + smoothstep(0.12, 0.07, length(rk - float2(-0.05, 0.45)));
comp_69=`  rockCol = float3(0.46, 0.45, 0.47) * (0.22 + 0.9 * rl) * (1 - 0.35 * saturate(rcr));
comp_70=`  rockCol += float3(0.6, 0.6, 0.62) * smoothstep(0.004, 0.0, abs(rd)) * 0.25;
comp_71=`  col = lerp(col, rockCol, smoothstep(0.0015, -0.0015, rd) * smoothstep(1.0, 0.75, z));
comp_72=`  }
comp_73=`  z = max(q6, 0.01);
comp_74=`  rc = float2(cos(q10), sin(q10)) * q14 / z;
comp_75=`  rs = 0.0055 / z;
comp_76=`  if (length(p - rc) < rs * 1.3 + 0.004) {
comp_77=`  rq = (p - rc) / rs;
comp_78=`  ra = atan2(rq.y, rq.x) + time * 0.3300 + 3.4700;
comp_79=`  rd = (length(rq) - (1 + 0.16 * sin(5 * ra + 3.4700) + 0.08 * sin(9 * ra + 6.9400))) * rs;
comp_80=`  rn = rq / 1.15;
comp_81=`  rl = saturate(dot(float3(rn, sqrt(saturate(1 - dot(rn, rn)))), float3(-0.45, 0.5, 0.74)));
comp_82=`  rk = float2(rq.x * cos(time * 0.3300 + 3.4700) + rq.y * sin(time * 0.3300 + 3.4700), rq.y * cos(time * 0.3300 + 3.4700) - rq.x * sin(time * 0.3300 + 3.4700));
comp_83=`  rcr = smoothstep(0.24, 0.17, length(rk - float2(0.32, 0.22))) + smoothstep(0.17, 0.11, length(rk - float2(-0.30, -0.33))) + smoothstep(0.12, 0.07, length(rk - float2(-0.05, 0.45)));
comp_84=`  rockCol = float3(0.46, 0.45, 0.47) * (0.22 + 0.9 * rl) * (1 - 0.35 * saturate(rcr));
comp_85=`  rockCol += float3(0.6, 0.6, 0.62) * smoothstep(0.004, 0.0, abs(rd)) * 0.25;
comp_86=`  col = lerp(col, rockCol, smoothstep(0.0015, -0.0015, rd) * smoothstep(1.0, 0.75, z));
comp_87=`  }
comp_88=`  z = max(q7, 0.01);
comp_89=`  rc = float2(cos(q11), sin(q11)) * q15 / z;
comp_90=`  rs = 0.0055 / z;
comp_91=`  if (length(p - rc) < rs * 1.3 + 0.004) {
comp_92=`  rq = (p - rc) / rs;
comp_93=`  ra = atan2(rq.y, rq.x) + time * 0.4100 + 5.6400;
comp_94=`  rd = (length(rq) - (1 + 0.16 * sin(5 * ra + 5.6400) + 0.08 * sin(9 * ra + 11.2800))) * rs;
comp_95=`  rn = rq / 1.15;
comp_96=`  rl = saturate(dot(float3(rn, sqrt(saturate(1 - dot(rn, rn)))), float3(-0.45, 0.5, 0.74)));
comp_97=`  rk = float2(rq.x * cos(time * 0.4100 + 5.6400) + rq.y * sin(time * 0.4100 + 5.6400), rq.y * cos(time * 0.4100 + 5.6400) - rq.x * sin(time * 0.4100 + 5.6400));
comp_98=`  rcr = smoothstep(0.24, 0.17, length(rk - float2(0.32, 0.22))) + smoothstep(0.17, 0.11, length(rk - float2(-0.30, -0.33))) + smoothstep(0.12, 0.07, length(rk - float2(-0.05, 0.45)));
comp_99=`  rockCol = float3(0.46, 0.45, 0.47) * (0.22 + 0.9 * rl) * (1 - 0.35 * saturate(rcr));
comp_100=`  rockCol += float3(0.6, 0.6, 0.62) * smoothstep(0.004, 0.0, abs(rd)) * 0.25;
comp_101=`  col = lerp(col, rockCol, smoothstep(0.0015, -0.0015, rd) * smoothstep(1.0, 0.75, z));
comp_102=`  }
comp_103=`  z = max(q8, 0.01);
comp_104=`  rc = float2(cos(q12), sin(q12)) * q16 / z;
comp_105=`  rs = 0.0055 / z;
comp_106=`  if (length(p - rc) < rs * 1.3 + 0.004) {
comp_107=`  rq = (p - rc) / rs;
comp_108=`  ra = atan2(rq.y, rq.x) + time * 0.4900 + 7.8100;
comp_109=`  rd = (length(rq) - (1 + 0.16 * sin(5 * ra + 7.8100) + 0.08 * sin(9 * ra + 15.6200))) * rs;
comp_110=`  rn = rq / 1.15;
comp_111=`  rl = saturate(dot(float3(rn, sqrt(saturate(1 - dot(rn, rn)))), float3(-0.45, 0.5, 0.74)));
comp_112=`  rk = float2(rq.x * cos(time * 0.4900 + 7.8100) + rq.y * sin(time * 0.4900 + 7.8100), rq.y * cos(time * 0.4900 + 7.8100) - rq.x * sin(time * 0.4900 + 7.8100));
comp_113=`  rcr = smoothstep(0.24, 0.17, length(rk - float2(0.32, 0.22))) + smoothstep(0.17, 0.11, length(rk - float2(-0.30, -0.33))) + smoothstep(0.12, 0.07, length(rk - float2(-0.05, 0.45)));
comp_114=`  rockCol = float3(0.46, 0.45, 0.47) * (0.22 + 0.9 * rl) * (1 - 0.35 * saturate(rcr));
