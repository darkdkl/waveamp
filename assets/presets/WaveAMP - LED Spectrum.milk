comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = float2(uv.x, 1 - uv.y);
comp_4=`  float fx = p.x * 16;
comp_5=`  float b = floor(fx);
comp_6=`  float inb = fx - b;
comp_7=`  float h = 0;
comp_8=`  float pk = 0;
comp_9=`  h += (b == 0) * q1;
comp_10=`  h += (b == 1) * q2;
comp_11=`  h += (b == 2) * q3;
comp_12=`  h += (b == 3) * q4;
comp_13=`  h += (b == 4) * q5;
comp_14=`  h += (b == 5) * q6;
comp_15=`  h += (b == 6) * q7;
comp_16=`  h += (b == 7) * q8;
comp_17=`  h += (b == 8) * q9;
comp_18=`  h += (b == 9) * q10;
comp_19=`  h += (b == 10) * q11;
comp_20=`  h += (b == 11) * q12;
comp_21=`  h += (b == 12) * q13;
comp_22=`  h += (b == 13) * q14;
comp_23=`  h += (b == 14) * q15;
comp_24=`  h += (b == 15) * q16;
comp_25=`  pk += (b == 0) * q17;
comp_26=`  pk += (b == 1) * q18;
comp_27=`  pk += (b == 2) * q19;
comp_28=`  pk += (b == 3) * q20;
comp_29=`  pk += (b == 4) * q21;
comp_30=`  pk += (b == 5) * q22;
comp_31=`  pk += (b == 6) * q23;
comp_32=`  pk += (b == 7) * q24;
comp_33=`  pk += (b == 8) * q25;
comp_34=`  pk += (b == 9) * q26;
comp_35=`  pk += (b == 10) * q27;
comp_36=`  pk += (b == 11) * q28;
comp_37=`  pk += (b == 12) * q29;
comp_38=`  pk += (b == 13) * q30;
comp_39=`  pk += (b == 14) * q31;
comp_40=`  pk += (b == 15) * q32;
comp_41=`  float base = 0.30;
comp_42=`  float top = base + h * 0.62;
comp_43=`  float seg = frac((p.y - base) * 40);
comp_44=`  float inBar = step(0.14, inb) * step(inb, 0.86);
comp_45=`  float3 hue = float3(0.30, 1.00, 0.45);
comp_46=`  float lit = inBar * step(base, p.y) * step(p.y, top) * step(0.22, seg);
comp_47=`  float bright = 0.55 + 0.45 * (p.y - base) / 0.62;
comp_48=`  float3 col = hue * lit * bright * 1.3;
comp_49=`  float off = inBar * step(base, p.y) * step(p.y, base + 0.62) * step(0.22, seg) * (1 - lit);
comp_50=`  col += hue * off * 0.12;
comp_51=`  float cap = inBar * step(abs(p.y - (base + pk * 0.62 + 0.012)), 0.006);
comp_52=`  col += float3(1, 1, 1) * cap * 0.9;
comp_53=`  float refl = inBar * step(p.y, base - 0.01) * step(base - 0.01 - h * 0.25, p.y) * step(0.22, frac((base - p.y) * 40));
comp_54=`  col += hue * refl * 0.22;
comp_55=`  float halo = inBar * step(base, p.y) * smoothstep(0.08, 0.0, abs(p.y - top)) * step(0.02, h);
comp_56=`  col += hue * halo * 0.25;
comp_57=`  ret = col;
comp_58=`}
