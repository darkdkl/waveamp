per_frame_1=t = min(1, max(0, (bass_att - 0.55) / 1.25));
per_frame_2=gmegabuf(0) = gmegabuf(0) + (t - gmegabuf(0)) * 0.12;
per_frame_3=q1 = gmegabuf(0);
per_frame_4=t = min(1, max(0, (mid_att - 0.55) / 1.25));
per_frame_5=gmegabuf(1) = gmegabuf(1) + (t - gmegabuf(1)) * 0.12;
per_frame_6=q2 = gmegabuf(1);
per_frame_7=t = min(1, max(0, (treb_att - 0.55) / 1.25));
per_frame_8=gmegabuf(2) = gmegabuf(2) + (t - gmegabuf(2)) * 0.12;
per_frame_9=q3 = gmegabuf(2);
comp_1=`float seg(float2 p, float2 a, float2 b) { float2 pa = p - a; float2 ba = b - a; float h = saturate(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }
comp_2=`shader_body
comp_3=`{
comp_4=`  float2 p = (uv - 0.5) * aspect.xy / min(aspect.x, aspect.y);
comp_5=`  p.y = -p.y;
comp_6=`  float3 col = lerp(float3(0.07, 0.075, 0.09), float3(0.17, 0.18, 0.21), saturate(p.y + 0.5));
comp_7=`  col *= 1 - 0.35 * length(p * float2(0.7, 1));
comp_8=`  float3 wave = tex2D(sampler_main, uv).xyz;
comp_9=`  float3 wglow = GetBlur1(uv);
comp_10=`  col += wave * 0.45 + wglow * 0.55;
comp_11=`  float2 lp = p - float2(0, 0.008 * sin(time * 0.6));
comp_12=`  float glow = 0;
comp_13=`  float fillA;
comp_14=`  float3 barC;
comp_15=`  float3 knobC;
comp_16=`
comp_17=`  float d0 = seg(lp, float2(-0.1494, -0.1245), float2(-0.1494, 0.1245)) - 0.0498;
comp_18=`  float2 kc0 = float2(-0.1494, lerp(-0.1233, 0.1233, q1));
comp_19=`  float kd0 = length(lp - kc0);
comp_20=`  float d1 = seg(lp, float2(0.0000, -0.2075), float2(0.0000, 0.2075)) - 0.0498;
comp_21=`  float2 kc1 = float2(0.0000, lerp(-0.2063, 0.2063, q2));
comp_22=`  float kd1 = length(lp - kc1);
comp_23=`  float d2 = seg(lp, float2(0.1494, -0.0415), float2(0.1494, 0.0415)) - 0.0498;
comp_24=`  float2 kc2 = float2(0.1494, lerp(-0.0403, 0.0403, q3));
comp_25=`  float kd2 = length(lp - kc2);
comp_26=`  glow += exp(-max(d0, 0) * 38) * (0.30 + 0.55 * q1);
comp_27=`  glow += exp(-max(d1, 0) * 38) * (0.30 + 0.55 * q2);
comp_28=`  glow += exp(-max(d2, 0) * 38) * (0.30 + 0.55 * q3);
comp_29=`  col += float3(0.35, 0.95, 0.55) * glow * 0.45;
comp_30=`
comp_31=`  fillA = smoothstep(0.003, -0.003, d0);
comp_32=`  barC = lerp(float3(0.35, 0.85, 0.52), float3(0.66, 0.96, 0.74), saturate((lp.y - -0.1743) / 0.3486)) * (0.85 + 0.3 * q1);
comp_33=`  col = lerp(col, barC, fillA);
comp_34=`  col *= 1 - 0.25 * smoothstep(0.0590, 0.0290, length(lp - kc0 + float2(0, 0.012))) * fillA;
comp_35=`  fillA = smoothstep(0.003, -0.003, d1);
comp_36=`  barC = lerp(float3(0.35, 0.85, 0.52), float3(0.66, 0.96, 0.74), saturate((lp.y - -0.2573) / 0.5146)) * (0.85 + 0.3 * q2);
comp_37=`  col = lerp(col, barC, fillA);
comp_38=`  col *= 1 - 0.25 * smoothstep(0.0590, 0.0290, length(lp - kc1 + float2(0, 0.012))) * fillA;
comp_39=`  fillA = smoothstep(0.003, -0.003, d2);
comp_40=`  barC = lerp(float3(0.35, 0.85, 0.52), float3(0.66, 0.96, 0.74), saturate((lp.y - -0.0913) / 0.1826)) * (0.85 + 0.3 * q3);
comp_41=`  col = lerp(col, barC, fillA);
comp_42=`  col *= 1 - 0.25 * smoothstep(0.0590, 0.0290, length(lp - kc2 + float2(0, 0.012))) * fillA;
comp_43=`  knobC = lerp(float3(0.80, 0.81, 0.85), float3(0.95, 0.95, 0.97), saturate((lp.y - kc0.y) / 0.0390 * 0.5 + 0.5));
comp_44=`  col = lerp(col, float3(0.02, 0.02, 0.02), smoothstep(0.0420, 0.0390, kd0));
comp_45=`  col = lerp(col, knobC, smoothstep(0.0355, 0.0325, kd0));
comp_46=`  knobC = lerp(float3(0.80, 0.81, 0.85), float3(0.95, 0.95, 0.97), saturate((lp.y - kc1.y) / 0.0390 * 0.5 + 0.5));
comp_47=`  col = lerp(col, float3(0.02, 0.02, 0.02), smoothstep(0.0420, 0.0390, kd1));
comp_48=`  col = lerp(col, knobC, smoothstep(0.0355, 0.0325, kd1));
comp_49=`  knobC = lerp(float3(0.80, 0.81, 0.85), float3(0.95, 0.95, 0.97), saturate((lp.y - kc2.y) / 0.0390 * 0.5 + 0.5));
comp_50=`  col = lerp(col, float3(0.02, 0.02, 0.02), smoothstep(0.0420, 0.0390, kd2));
comp_51=`  col = lerp(col, knobC, smoothstep(0.0355, 0.0325, kd2));
comp_52=`  ret = col;
comp_53=`}
